"          image = \"docker.io/mbentley/apt-cacher-ng\";\n"
"          ports = [\n"
"            \"3142:3142\"\n"
"          ];\n"
"          volumes = [\n"
"            "
"\"/home/acng/containers/acng.conf:/etc/apt-cacher-ng/acng.conf\"\n"
"            \"/home/acng/containers/acng/:/var/cache/apt-cacher-ng/\"\n"
"          ];\n"
"          environment = {\n"
